{
  "manifest_version": 3,
  "name": "YouTube Focus",
  "version": "1.1.0",
  "description": "Nasconde Shorts, video consigliati e commenti; porta sempre alle iscrizioni invece che alla Home.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtube.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "redirects",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "css": [
        "hide-shorts.css",
        "hide-distractions.css"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "YouTube Focus",
    "default_popup": "popup.html"
  }
}
